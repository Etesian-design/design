{
  "name": "etesian-design",
  "version": "0.3.2",
  "private": true,
  "description": "Etesian Design Language: the guide, Storybook and the source of the @etesian-design packages (packages/)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "tokens": "node scripts/build-tokens.ts && node scripts/build-font-css.ts",
    "storybook": "npm run tokens && storybook dev -p 6006",
    "build-storybook": "npm run tokens && storybook build",
    "build": "node scripts/build-packages.mjs",
    "check": "vue-tsc -p tsconfig.json --noEmit",
    "test": "npm run tokens && npm run check && vitest run",
    "pack-packages": "node scripts/build-packages.mjs && for p in tokens vue quasar shell; do (cd packages/$p && npm pack --pack-destination ../../dist-packs); done"
  },
  "devDependencies": {
    "@fontsource/fira-sans": "^5.3.0",
    "@fontsource/hind": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "@fontsource/signika": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@fontsource/ubuntu": "^5.3.0",
    "@fontsource/ubuntu-sans": "^5.3.0",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/vue3-vite": "^10.6.3",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.3",
    "quasar": "^2.35.2",
    "sass-embedded": "^1.106.1",
    "storybook": "^10.6.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^2.2.12"
  }
}
