{
  "name": "etesian-design",
  "version": "0.1.0",
  "description": "Etesian Design Language: N9 (MeeGo Etesian) inspired style guide and Vue 3 components",
  "license": "MIT",
  "type": "module",
  "main": "./dist/etesian.umd.cjs",
  "module": "./dist/etesian.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/etesian.js",
      "require": "./dist/etesian.umd.cjs"
    },
    "./style.css": "./dist/etesian.css",
    "./tokens.css": "./src/styles/tokens.css",
    "./quasar": {
      "import": "./dist/quasar.js",
      "types": "./dist/quasar/index.d.ts"
    },
    "./quasar/theme.css": "./src/quasar/etesian-quasar.css",
    "./quasar/variables.scss": "./src/quasar/quasar-variables.scss"
  },
  "files": [
    "dist",
    "src/styles",
    "tokens",
    "src/quasar"
  ],
  "scripts": {
    "tokens": "node scripts/build-tokens.ts && node scripts/build-font-css.ts",
    "storybook": "npm run tokens && storybook dev -p 6006",
    "build-storybook": "npm run tokens && storybook build",
    "build": "npm run tokens && vite build && vite build -c vite.quasar.config.ts && vue-tsc -p tsconfig.build.json --emitDeclarationOnly",
    "check": "vue-tsc -p tsconfig.json --noEmit",
    "test": "npm run tokens && npm run check && vitest run"
  },
  "peerDependencies": {
    "quasar": "^2.14.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@fontsource/fira-sans": "^5.3.0",
    "@fontsource/hind": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "@fontsource/signika": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@fontsource/ubuntu": "^5.3.0",
    "@fontsource/ubuntu-sans": "^5.3.0",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/vue3-vite": "^10.6.3",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.3",
    "quasar": "^2.35.2",
    "sass-embedded": "^1.106.1",
    "storybook": "^10.6.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^2.2.12"
  },
  "peerDependenciesMeta": {
    "quasar": {
      "optional": true
    }
  }
}
