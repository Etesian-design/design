{
  "name": "@etesian-design/quasar",
  "version": "0.3.2",
  "description": "Etesian theme and integration for Quasar 2: brand colours, icon set, the squircle spinner and colour modes",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Etesian-design/design.git",
    "directory": "packages/quasar"
  },
  "homepage": "https://etesian-design.com",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./*.css": "./dist/*.css",
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./theme.css": "./dist/etesian-quasar.css",
    "./variables.scss": "./dist/quasar-variables.scss"
  },
  "dependencies": {
    "@etesian-design/tokens": "^0.3.2",
    "@etesian-design/vue": "^0.3.2"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "quasar": "^2.14.0"
  }
}
