{
  "name": "@etesian-design/vue",
  "version": "0.4.0",
  "description": "Etesian Vue 3 components: the N9-style building blocks (Hd*), composables and squircle geometry",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Etesian-design/design.git",
    "directory": "packages/vue"
  },
  "homepage": "https://etesian-design.com",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./*.css": "./dist/*.css",
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "dependencies": {
    "@etesian-design/tokens": "^0.4.0"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  }
}
